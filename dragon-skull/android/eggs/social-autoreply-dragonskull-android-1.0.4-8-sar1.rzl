 "files": {
  "scout.html": "<!doctype html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"UTF-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover, maximum-scale=1\" />\n    <title>DRAGON SKULL</title>\n    <link rel=\"icon\" type=\"image/png\" sizes=\"32x32\" href=\"./ds-icon-32.png\" />\n    <link rel=\"icon\" type=\"image/png\" sizes=\"192x192\" href=\"./ds-icon-192.png\" />\n    <link rel=\"apple-touch-icon\" sizes=\"180x180\" href=\"./apple-touch-icon.png\" />\n    <link rel=\"stylesheet\" href=\"./scout-style.css\" />\n    <link rel=\"stylesheet\" href=\"./ds-mobile.css\" />\n    <script defer src=\"./dg-web.js\"></script>\n    <script defer src=\"./ds-mobile.js\"></script>\n  </head>\n  <body>\n    <aside id=\"roster\" aria-label=\"Bots\">\n      <nav id=\"roster-list\" class=\"roster-list\"></nav>\n      <!-- Legacy single-tile hook kept for ROS_BOT applyBot + clay icon path -->\n      <button id=\"tile\" class=\"tile sr-only\" type=\"button\" aria-hidden=\"true\" tabindex=\"-1\">\n        <img src=\"./ybot-tile.png\" alt=\"\" />\n        <span>ЯBOT</span>\n      </button>\n      <small id=\"legacy-rid\" class=\"sr-only\"></small>\n    </aside>\n    <main>\n      <header id=\"bot-hero\">\n        <button id=\"hero-avatar-btn\" type=\"button\" title=\"Click the picture to edit this bot\" aria-label=\"Edit profile\">\n          <img id=\"chat-avatar\" alt=\"\" />\n          <span class=\"hero-pen\" aria-hidden=\"true\">✎</span>\n        </button>\n        <span id=\"chat-title\">ЯBOWSER</span>\n        <img id=\"ds-logo\" src=\"./ds-logo.png\" alt=\"DRAGON SKULL logo\" />\n        <small id=\"ds-status\" class=\"ds-status\">ENGINE</small>\n        <small id=\"chat-sub\" title=\"ЯID · read-only\">Select a bot</small>\n        <button id=\"chat-edit\" type=\"button\" onclick=\"window.ROS_EDIT_PROFILE &amp;&amp; window.ROS_EDIT_PROFILE()\">✎ Edit profile</button>\n      </header>\n      <section id=\"bot-edit\" hidden aria-label=\"Edit this bot\"></section>\n      <section id=\"log\" aria-live=\"polite\"></section>\n      <form id=\"composer\">\n        <input id=\"message\" autofocus autocomplete=\"off\" placeholder=\"Message your bot\" />\n        <button type=\"submit\">Send</button>\n      </form>\n    </main>\n    <script defer src=\"./rid-roster.js\"></script>\n    <script defer src=\"./skills/notes-reader/rzl-notes-reader.js\"></script>\n    <script defer src=\"./scout-app.js\"></script>\n    <script defer src=\"./chatlist.js\"></script>\n    <script defer src=\"./skills/bot-sidebar/bot-sidebar.js\"></script>\n    <script defer src=\"./skills/batibabox-rt/bbx-rt.js\"></script>\n    <script defer src=\"./skills/identity-guard/identity-guard-rt.js\"></script>\n    <script defer src=\"./skills/botwin/botwin.js\"></script>\n    <script defer src=\"./skills/thundr-live/thundr-adapter.js\"></script>\n    <script defer src=\"./ds-selfupdate.js\"></script>\n    <script defer src=\"./skills/batibabox-ds/bbx-ds-core.js\"></script>\n    <script defer src=\"./skills/batibabox-ds/bbx-ds.js\"></script>\n    <script defer src=\"./skills/batibabox-ds/ds-mind-view.js\"></script>\n    <script defer src=\"./skills/parts-guide/parts-guide.js\"></script>\n    <script defer src=\"./skills/qr-pair/qrcode-gen.js\"></script>\n    <script defer src=\"./skills/qr-pair/qr-pair.js\"></script>\n    <link rel=\"stylesheet\" href=\"./skills/crypto-side-panel/crypto-side-panel.css?v=20261025Q-ios\">\n    <script defer src=\"./skills/crypto-side-panel/crypto-side-panel.js?v=20261025Q-ios\"></script>\n  </body>\n</html>\n",
  "skills/crypto-side-panel/crypto-side-panel.js": "/* RDRAGON · CRYPTO SIDE PANEL — CryptoSocial profile inside RDRAGON left slot (#roster). All controls functional, offline (localStorage). t50u–t53u.\n   Toggle: × / + or Cmd/Ctrl+Shift+K. ?csp=0 disables. API: window.RDRAGON_CSP */\n(function(){\n if(window.__CSP)return;window.__CSP=1;if(/[?&]csp=0/.test(location.search))return;\n var LS=\"rdragon.csp.v2\",base=(document.currentScript&&document.currentScript.src||\"\").replace(/[^/]*$/,\"\")||\"./skills/crypto-side-panel/\";\n var D={on:true,tab:\"Posts\",nav:\"home\",rdg:\"0.00\",following:0,followers:0,follow:{},avatar:\"\",banner:\"\",\n  eng:{reply:13,repost:3,like:3,views:378,liked:false,reposted:false},replies:[],posts:[],alerts:[\"Welcome to CryptoSocial on RDRAGON\"],msgs:[],prof:{title:\"Anti Social CryptoSocial Media\",name:\"Rizal the Younger\",handle:\"@chaserizal\",bio:\"PaleoAnthropologist from the Distant Future | Buy: a.co/d/6zvEHwf | IF OUR WORLD IS A LIE, TRUTH IS THE GREATEST DECEPTION. Give: cash.app/$chaserizal\",location:\"Mount Olympus, UT\",link:\"a.co/d/47uq2zX\",joined:\"April 2019\",verified:\"SUPER VERIFIED\",pname:\"Rizal the Valentinian\",preply:\"Replying to @IGLESIARIZAL\",ptext:\"\"}};\n var S;try{S=Object.assign({},D,JSON.parse(localStorage.getItem(LS)||\"{}\"))}catch(e){S=D}S.prof=Object.assign({},D.prof,S.prof||{});S.bot=S.bot||{};S.draft=[];norm();\n function F(k){return '<span class=\"csp-ed\" contenteditable=\"plaintext-only\" spellcheck=\"false\" data-e=\"'+k+'\" title=\"click to edit\">'+E(S.prof[k])+'</span>'}\n function linkify(s){return E(s).match(/(?:https?:\\/\\/)?(?:a\\.co|cash\\.app)\\/[^\\s|]+/g)||[]}\n function links(s){return linkify(s).map(function(u){return '<a href=\"'+(/^http/.test(u)?u:\"https://\"+u)+'\" target=\"_blank\" rel=\"noopener\">'+u+' ↗</a>'}).join(\" \")}\n function save(){try{localStorage.setItem(LS,JSON.stringify(S))}catch(e){toast(\"storage full — image too big?\")}}\n function E(s){return String(s).replace(/[&<>\"]/g,function(c){return{\"&\":\"&amp;\",\"<\":\"&lt;\",\">\":\"&gt;\",'\"':\"&quot;\"}[c]})}\n var CASH=\"https://cash.app/$chaserizal\";\n var people=[[\"@chaserizal\",\"Rizal the Younger\"],[\"@IGLESIARIZAL\",\"Iglesia Rizal\"],[\"@grok\",\"Grok\"],[\"@RDRAGON\",\"RDRAGON\"],[\"@ThundR\",\"ThundR\"]];\n var lines=[\"@grok : Xfile : Professor X\",\"© Aetaneo Rizal : Hortus Edenis\",\"Tales of the Twilight from the Crypt\",\"Beyond the nuclear looking\",\"Jesus Aliens Ghosts &amp; Cryptids\",\"NOVA CONSTELLATIO\",\"#1116 Give cash.app/$chaserizal\",\"Doctor rerum zcientiarum luznaturalium\",\"❤\"];\n var stub={Video:[\"Tales of the Twilight — teaser\",\"NOVA CONSTELLATIO — starfield loop\",\"RDRAGON offline image-gen demo\"],\n  Articles:[\"IF OUR WORLD IS A LIE, TRUTH IS THE GREATEST DECEPTION\",\"PaleoAnthropology from the Distant Future\",\"Hortus Edenis — notes\"],\n  Projects:[\"RDRAGON · Neo + iOS\",\"THUNDR · free-floating\",\"Project BOTZURECTION\",\"PROJECT-XYZR\",\"CryptoSocial · RDG wallet\"]};\n var p,tt;\n /* t73u–t75u AUTO-REPLY: RDRAGON answers EVERY user post + EVERY comment (all posts), no prompt/@tag. Replies are about the post text AND its media.\n    Model: Neo llama-server :4979 (always tried first, even if navigator.onLine=false). Media: WRAP :8319 /api/upload + /api/describe (VLM/Vision OCR), cached per attachment; video = frame grab -> same describe.\n    Offline/model down: local reply quoting key words + media name appears immediately, upgraded to model reply on retry (load, 'online', every 60 s). Keys = unique ids. Bot replies never trigger replies. */\n var AI=\"http://127.0.0.1:4979/v1/chat/completions\",WRAP=\"http://127.0.0.1:8319\",busy={};S.desc=S.desc||{};\n function uid(){return Date.now().toString(36)+Math.random().toString(36).slice(2,7)}\n function norm(){S.posts=(S.posts||[]).map(function(x){return typeof x===\"string\"?{id:uid(),t:x,media:[],c:[]}:(x.c=x.c||[],x.media=x.media||[],x)});S.replies=(S.replies||[]).map(function(r){return typeof r===\"string\"?{id:uid(),t:r}:r})}\n function fb(t,m){var w=(String(t).match(/[A-Za-z$#][\\w$#]{3,}/g)||[\"that\"]).sort(function(a,b){return b.length-a.length})[0],h=0;for(var i=0;i<t.length;i++)h=(h*31+t.charCodeAt(i))|0;var T=[\"The ledger remembers \\\"W\\\". RDRAGON has witnessed it.\",\"Fire noted. \\\"W\\\" now burns in the dragon's memory.\",\"From the skull: \\\"W\\\" — keep building, Decider.\",\"RDRAGON reads \\\"W\\\" and approves. The hoard grows.\",\"Offline or online, \\\"W\\\" is sealed in the chain of the dragon.\"];var r=T[Math.abs(h)%T.length].replace(\"W\",w.slice(0,40));return m&&m.length?r+\" (Eyes on your \"+m[0].type+\" \"+m[0].name+\".)\":r}\n function to(ms){var c=new AbortController();setTimeout(function(){c.abort()},ms);return c.signal}\n function src2b64(src){return src.indexOf(\"data:\")===0?Promise.resolve(src):fetch(src).then(function(r){return r.blob()}).then(function(b){return new Promise(function(ok){var f=new FileReader();f.onload=function(){ok(f.result)};f.readAsDataURL(b)})})}\n function describe(m){var k=m.key||m.id;if(S.desc[k])return Promise.resolve(S.desc[k]);\n  return src2b64(m.src).then(function(b64){return fetch(WRAP+\"/api/upload\",{method:\"POST\",signal:to(20000),headers:{\"Content-Type\":\"application/json\"},body:JSON.stringify({name:m.name.replace(/\\.\\w+$/,\"\")+(m.type===\"video\"?\"-frame.jpg\":/\\.\\w+$/.test(m.name)?m.name.match(/\\.\\w+$/)[0]:\".jpg\"),b64:b64})})}).then(function(r){return r.json()})\n  .then(function(u){if(!u.url)throw 0;return fetch(WRAP+\"/api/describe\",{method:\"POST\",signal:to(90000),headers:{\"Content-Type\":\"application/json\"},body:JSON.stringify({url:u.url})})}).then(function(r){return r.json()})\n  .then(function(d){if(d&&d.text&&!/^I couldn.t read/i.test(d.text)){S.desc[k]=(m.type===\"video\"?\"(frame from the video) \":\"\")+d.text;save()}return S.desc[k]}).catch(function(){return \"\"})}\n function mline(ms){return ms.map(function(m){return m.type+\" \\\"\"+m.name+\"\\\"\"+(S.desc[m.key||m.id]?\" — what it shows: \"+S.desc[m.key||m.id]:\" (not yet described)\")}).join(\"; \")}\n var PM={key:\"asset:post.jpg\",type:\"image\",name:\"post.jpg\"};\n function bot(id,t,media,parent){if(S.bot[id])return;var pp=parent&&parent.pid?S.posts.filter(function(x){return x.id===parent.pid})[0]:parent;S.bot[id]={t:fb(t,media.length?media:pp&&pp.media&&pp.media.length?pp.media:parent?[PM]:[]),src:\"local\",q:t,m:media,par:parent||null};save();ai(id)}\n function ai(id){var b=S.bot[id];if(!b||b.src===\"model\"||busy[id])return;busy[id]=1;var par=b.par&&b.par.pid?S.posts.filter(function(x){return x.id===b.par.pid})[0]||{t:\"(deleted post)\",media:[]}:b.par,pm=par?(par.media&&par.media.length?par.media:[PM]):[],all=(b.m||[]).concat(pm);\n  pm.forEach(function(m){if(m===PM)m.src=base+\"assets/post.jpg\"});\n  Promise.all(all.map(describe)).then(function(){var q=(par?\"PARENT POST:\\n\"+par.t+(pm.length?\"\\nPARENT POST MEDIA: \"+mline(pm):\"\")+\"\\n\\nUSER COMMENT on that post:\\n\":\"USER POST:\\n\")+b.q+(b.m&&b.m.length?\"\\nATTACHED MEDIA: \"+mline(b.m):\"\");\n   return fetch(AI,{method:\"POST\",signal:to(30000),headers:{\"Content-Type\":\"application/json\"},body:JSON.stringify({messages:[{role:\"system\",content:\"You are RDRAGON, the dragon-skull AI of the CryptoSocial panel. Reply to the post or comment below in one or two short in-character sentences (max 220 chars). Your reply MUST be specifically about its words and about what its attached media shows (use the media description); for a comment, tie it to the parent post. Never generic. Speak directly to the poster as you; never say \\\"the user\\\". No hashtags, no @mentions.\"},{role:\"user\",content:q}],max_tokens:90,temperature:0.7})})})\n  .then(function(r){return r.json()}).then(function(j){var t=((j.choices||[])[0]||{}).message;t=t&&String(t.content||\"\").replace(/^\\s*(RDRAGON|ASSISTANT)\\s*[:>-]\\s*/i,\"\").split(/\\b(?:USER\\s*(?:POST|COMMENT)?\\s*:|PARENT POST|ATTACHED MEDIA|USER COMMENT)/i)[0].replace(/^[\"\\s]+|[\"\\s]+$/g,\"\").slice(0,280);if(t&&t.replace(/\\W/g,\"\").length>=12&&S.bot[id]){S.bot[id].t=t;S.bot[id].src=\"model\";save();render()}}).catch(function(){}).then(function(){delete busy[id]})}\n function bk(id){var b=S.bot[id];return b?'<div class=\"csp-row csp-bot\"><span><b>RDRAGON</b> <span class=\"csp-dim\">@RDRAGON · auto'+(b.src===\"model\"?'':' · offline')+'</span><br>↳ '+E(b.t)+'</span></div>':''}\n function retry(){Object.keys(S.bot).forEach(ai)}window.addEventListener(\"online\",retry);setInterval(retry,60000);\n function attach(){var i=document.createElement(\"input\");i.type=\"file\";i.accept=\"image/*,video/*\";i.onchange=function(){var f=i.files&&i.files[0];if(!f)return;var m={id:uid(),name:f.name,type:/^video/.test(f.type)?\"video\":\"image\"};\n  function done(u){m.src=u;S.draft=(S.draft||[]).concat([m]);var ta=p.querySelector(\"#csp-new\"),keep=ta?ta.value:\"\";render();var t2=p.querySelector(\"#csp-new\");if(t2)t2.value=keep;toast(m.type+\" attached · \"+f.name)}\n  if(m.type===\"image\")return shrink(f,900,done);var v=document.createElement(\"video\"),url=URL.createObjectURL(f);v.muted=true;v.preload=\"auto\";v.src=url;v.onloadeddata=function(){v.currentTime=Math.min(1,(v.duration||2)/2)};v.onseeked=function(){var c=document.createElement(\"canvas\"),k=Math.min(1,900/Math.max(v.videoWidth,v.videoHeight));c.width=Math.round(v.videoWidth*k);c.height=Math.round(v.videoHeight*k);c.getContext(\"2d\").drawImage(v,0,0,c.width,c.height);URL.revokeObjectURL(url);done(c.toDataURL(\"image/jpeg\",.8))}};i.click()}\n function mhtml(ms){return (ms||[]).map(function(m){return '<div class=\"csp-img\" style=\"height:140px;background-image:url('+m.src+')\" title=\"'+E(m.type+\" · \"+m.name)+'\">'+(m.type===\"video\"?'<span class=\"csp-dim\">▶ '+E(m.name)+'</span>':'')+'</div>'}).join(\"\")}\n function toast(m){var t=p.querySelector(\".csp-toast\");t.textContent=m;t.style.display=\"block\";clearTimeout(tt);tt=setTimeout(function(){t.style.display=\"none\"},2600)}\n function img(k,def){return S[k]?'url('+S[k]+')':'url('+base+'assets/'+def+')'}\n function postCard(){var e=S.eng;return '<div class=\"csp-card\"><div class=\"l w\">'+F(\"pname\")+'</div><div class=\"rep\">'+F(\"preply\")+'</div>'+'<div class=\"csp-ed csp-ptext\" contenteditable=\"plaintext-only\" spellcheck=\"false\" data-e=\"ptext\" title=\"click to edit post\">'+(S.prof.ptext?E(S.prof.ptext):lines.map(function(l){return \"✓ \"+l}).join(\"\\n\"))+'</div>'+\n  '<div class=\"csp-img\" style=\"background-image:url('+base+'assets/post.jpg)\"></div>'+\n  '<div class=\"csp-eng\"><span data-a=\"reply\">💬 '+e.reply+'</span><span data-a=\"repost\" class=\"rp'+(e.reposted?' on':'')+'\">🔁 '+e.repost+'</span><span data-a=\"like\" class=\"'+(e.liked?'on':'')+'\">♥ '+e.like+'</span><span data-a=\"views\">📊 '+e.views+'</span></div>'+\n  '<div class=\"csp-replybox\" style=\"display:none\"><input class=\"csp-in\" placeholder=\"reply…\" maxlength=\"280\"><button data-a=\"sendreply\">reply</button></div>'+\n  S.replies.map(function(r){return '<div class=\"csp-row\"><span>↳ '+E(r.t)+'</span></div>'+bk(r.id)}).join(\"\")+'</div>'}\n function view(){var v=\"\";\n  if(S.nav===\"search\")v='<input class=\"csp-in\" id=\"csp-q\" placeholder=\"search people, posts, #tags\" autofocus><div id=\"csp-res\"></div>';\n  else if(S.nav===\"compose\")v='<textarea class=\"csp-in\" id=\"csp-new\" rows=\"4\" maxlength=\"500\" placeholder=\"what\\'s happening, Decider?\"></textarea>'+mhtml(S.draft)+'<button data-a=\"attach\">📎 photo/video</button> <button data-a=\"post\">post</button> <button data-a=\"home\">cancel</button>';\n  else if(S.nav===\"alerts\")v=S.alerts.slice().reverse().map(function(a){return '<div class=\"csp-row\"><span>🔔 '+E(a)+'</span></div>'}).join(\"\")+'<button data-a=\"clearalerts\">clear</button>';\n  else if(S.nav===\"msgs\")v=(S.msgs.length?S.msgs.map(function(m){return '<div class=\"csp-row\"><span>✉ '+E(m)+'</span></div>'}).join(\"\"):'<div class=\"csp-dim\">no messages (offline inbox)</div>')+'<input class=\"csp-in\" id=\"csp-msg\" placeholder=\"message to self / note\"><button data-a=\"sendmsg\">send</button>';\n  else if(S.nav===\"people\")v='<div class=\"csp-dim\">&gt; who_to_follow</div>'+people.map(function(x){var on=S.follow[x[0]];return '<div class=\"csp-row\"><span>'+x[0]+'<br><span class=\"csp-dim\">'+x[1]+'</span></span><button data-a=\"follow\" data-h=\"'+x[0]+'\">'+(on?'following':'+ follow')+'</button></div>'}).join(\"\");\n  else if(S.tab===\"Posts\")v=S.posts.map(function(t,i){return [t,i]}).reverse().map(function(x){var o=x[0];return '<div class=\"csp-card\"><div class=\"l w\">'+E(S.prof.name)+' <span class=\"csp-dim\">'+E(S.prof.handle)+'</span><button class=\"csp-x\" data-a=\"delpost\" data-i=\"'+x[1]+'\" title=\"delete post\">✕</button></div><div class=\"l\" style=\"white-space:pre-wrap\">'+E(o.t)+'</div>'+mhtml(o.media)+bk(o.id)+'<div class=\"csp-eng\"><span data-a=\"reply\">💬 '+o.c.length+'</span></div><div class=\"csp-replybox\" style=\"display:none\"><input class=\"csp-in\" placeholder=\"comment…\" maxlength=\"280\"><button data-a=\"sendcomment\" data-i=\"'+x[1]+'\">reply</button></div>'+o.c.map(function(c){return '<div class=\"csp-row\"><span>↳ '+E(c.t)+'</span></div>'+bk(c.id)}).join(\"\")+'</div>'}).join(\"\")+postCard();\n  else v=stub[S.tab].map(function(t,i){return '<div class=\"csp-card\" data-a=\"open\" data-i=\"'+S.tab+': '+E(t)+'\"><div class=\"l\">'+E(t)+'</div><div class=\"csp-dim\">'+(S.tab===\"Video\"?\"▶ play (offline stub)\":S.tab===\"Articles\"?\"read\":\"open\")+'</div></div>'}).join(\"\");\n  return v}\n function render(){var keepScroll=p.scrollTop;\n  p.innerHTML='<div class=\"csp-top\">'+F(\"title\")+'<button class=\"csp-x\" data-a=\"toggle\" title=\"collapse (Cmd/Ctrl+Shift+K)\">'+(S.on?'×':'+')+'</button></div>'+\n  '<div class=\"csp-banner\" data-a=\"pickbanner\" title=\"click to change banner\" style=\"background-image:'+img(\"banner\",\"banner.jpg\")+'\"><img class=\"csp-gm\" src=\"'+base+'assets/ghostmachine-logo.jpg\" alt=\"GHOSTMACHINE\" title=\"GHOSTMACHINE\"><button class=\"csp-b csp-bv\" data-a=\"verified\" title=\"'+E(S.prof.verified)+' · click to edit badge\">✔ Verified</button><button class=\"csp-b csp-bw\" data-a=\"wallet\" title=\"RDG wallet · double-click to set balance\">&gt; Wallet</button></div>'+\n  '<div class=\"csp-av\" data-a=\"pickavatar\" title=\"click to change profile picture\" style=\"background-image:'+img(\"avatar\",\"avatar.jpg\")+'\"></div>'+\n  '<div class=\"csp-name\">'+F(\"name\")+'</div><div class=\"csp-handle\">'+F(\"handle\")+'</div>'+\n  (S.wopen?'<div class=\"csp-wx\"><div>balance <b>'+S.rdg+' RDG</b> <span class=\"csp-dim\">(local ledger · offline · no keys)</span></div><div style=\"margin:4px 0\"><a href=\"'+CASH+'\" target=\"_blank\" rel=\"noopener\">send via cash.app/$chaserizal ↗</a></div><button data-a=\"copyhandle\">copy $chaserizal</button> <button data-a=\"wallet\">close</button></div>':'')+\n  '<div class=\"csp-bm\"><div>'+F(\"bio\")+'<div class=\"csp-links\">'+links(S.prof.bio+\" \"+S.prof.link)+'</div></div>'+\n  '<div class=\"csp-meta\"><div>location · '+F(\"location\")+'</div><div>link · '+F(\"link\")+'</div><div>joined · '+F(\"joined\")+'</div></div>'+\n  '<div class=\"csp-ff\"><span data-a=\"people\"><b>'+S.following+'</b> Following</span> · <span data-a=\"people\"><b>'+S.followers+'</b> Followers</span></div></div>'+\n  '<div class=\"csp-tabs\">'+[\"Posts\",\"Video\",\"Articles\",\"Projects\"].map(function(t){return '<span data-a=\"tab\" data-t=\"'+t+'\" class=\"'+(t===S.tab&&S.nav===\"home\"?'on':'')+'\">'+t+'</span>'}).join(\"\")+'</div>'+\n  '<div class=\"csp-view\">'+view()+'</div>'+\n  '<div class=\"csp-nav\">'+[[\"home\",\"⌂\"],[\"search\",\"⌕\"],[\"compose\",\"+\"],[\"alerts\",\"🔔\"],[\"msgs\",\"✉\"]].map(function(n){return '<span data-a=\"nav\" data-n=\"'+n[0]+'\" class=\"'+(n[0]===\"compose\"?'plus ':'')+(S.nav===n[0]?'on':'')+'\" title=\"'+{home:\"Home\",search:\"Search\",compose:\"New post\",alerts:\"Alerts\",msgs:\"Messages\"}[n[0]]+'\">'+n[1]+'</span>'}).join(\"\")+'</div>'+\n  '<div class=\"csp-ready\"><b>C:\\\\SOCIAL&gt;</b><br>READY.</div><div class=\"csp-toast\" style=\"display:none\"></div>';\n  p.classList.toggle(\"csp-off\",!S.on);p.scrollTop=keepScroll;\n  var q=p.querySelector(\"#csp-q\");if(q){q.oninput=function(){var s=q.value.toLowerCase(),out=[];if(s){people.forEach(function(x){if((x[0]+x[1]).toLowerCase().indexOf(s)>-1)out.push(\"👤 \"+x[0]+\" · \"+x[1])});\n   [S.prof.name,S.prof.handle,S.prof.bio,S.prof.ptext||\"\"].concat(lines,S.posts.map(function(x){return x.t})).forEach(function(l){if(l.toLowerCase().indexOf(s)>-1)out.push(\"✓ \"+l)});[].concat(stub.Video,stub.Articles,stub.Projects).forEach(function(l){if(l.toLowerCase().indexOf(s)>-1)out.push(\"• \"+l)})}\n   p.querySelector(\"#csp-res\").innerHTML=out.length?out.map(function(o){return '<div class=\"csp-row\"><span>'+o+'</span></div>'}).join(\"\"):(s?'<div class=\"csp-dim\">no results</div>':'')};q.focus()}\n }\n function shrink(file,max,cb){var r=new FileReader();r.onload=function(){var im=new Image();im.onload=function(){var k=Math.min(1,max/Math.max(im.width,im.height)),c=document.createElement(\"canvas\");c.width=Math.round(im.width*k);c.height=Math.round(im.height*k);c.getContext(\"2d\").drawImage(im,0,0,c.width,c.height);cb(c.toDataURL(\"image/jpeg\",.85))};im.src=r.result};r.readAsDataURL(file)}\n function pick(key,max){var i=document.createElement(\"input\");i.type=\"file\";i.accept=\"image/*\";i.onchange=function(){var f=i.files&&i.files[0];if(!f)return;shrink(f,max,function(u){S[key]=u;save();render();toast((key===\"avatar\"?\"profile picture\":\"banner\")+\" updated · saved offline\")})};i.click()}\n function act(a,el){var e=S.eng;switch(a){\n  case \"toggle\":S.on=!S.on;break;\n  case \"verified\":var nv=prompt(\"Badge text (Cancel = show info)\",S.prof.verified);if(nv===null){toast(\"✔ \"+S.prof.verified+\" · \"+S.prof.handle+\" · RDRAGON local identity\");return}S.prof.verified=nv.trim()||D.prof.verified;break;\n  case \"pickbanner\":pick(\"banner\",1200);return;case \"pickavatar\":pick(\"avatar\",400);return;\n  case \"people\":S.nav=\"people\";break;\n  case \"follow\":var h=el.dataset.h;S.follow[h]=!S.follow[h];S.following=Object.keys(S.follow).filter(function(k){return S.follow[k]}).length;S.alerts.push((S.follow[h]?\"You followed \":\"You unfollowed \")+h);break;\n  case \"wallet\":S.wopen=!S.wopen;break;\n  case \"copyhandle\":(navigator.clipboard?navigator.clipboard.writeText(\"$chaserizal\"):Promise.reject()).then(function(){toast(\"copied $chaserizal\")},function(){toast(\"$chaserizal\")});return;\n  case \"tab\":S.tab=el.dataset.t;S.nav=\"home\";break;\n  case \"nav\":S.nav=el.dataset.n;if(S.nav===\"home\")S.tab=\"Posts\";break;case \"home\":S.nav=\"home\";S.tab=\"Posts\";break;\n  case \"reply\":var b=el.closest(\".csp-card\").querySelector(\".csp-replybox\");b.style.display=b.style.display===\"none\"?\"block\":\"none\";if(b.style.display===\"block\")b.querySelector(\"input\").focus();return;\n  case \"sendreply\":var inp=el.parentNode.querySelector(\"input\");if(!inp.value.trim())return toast(\"type a reply first\");var rid=uid();S.replies.push({id:rid,t:inp.value.trim()});bot(rid,inp.value.trim(),[],{t:S.prof.pname+\" (\"+S.prof.preply+\"): \"+(S.prof.ptext||lines.join(\"\\n\")),media:[]});e.reply++;S.alerts.push(\"You replied to Rizal the Valentinian\");break;\n  case \"repost\":e.reposted=!e.reposted;e.repost+=e.reposted?1:-1;break;\n  case \"like\":e.liked=!e.liked;e.like+=e.liked?1:-1;break;\n  case \"views\":e.views++;toast(\"📊 \"+e.views+\" views (local)\");save();el.textContent=\"📊 \"+e.views;return;\n  case \"attach\":attach();return;\n  case \"sendcomment\":var ci=el.parentNode.querySelector(\"input\"),po=S.posts[+el.dataset.i];if(!ci.value.trim())return toast(\"type a comment first\");var cid=uid();po.c.push({id:cid,t:ci.value.trim()});bot(cid,ci.value.trim(),[],{pid:po.id});S.alerts.push(\"You commented on your post\");break;\n  case \"delpost\":if(confirm(\"Delete this post?\")){S.posts.splice(+el.dataset.i,1)}break;\n  case \"post\":var t=p.querySelector(\"#csp-new\").value.trim();var dm=S.draft||[];if(!t&&!dm.length)return toast(\"write something first\");var pid=uid();S.posts.push({id:pid,t:t,media:dm,c:[]});S.draft=[];bot(pid,t||\"(media only)\",dm);S.alerts.push(\"Posted: \"+t.slice(0,40));S.nav=\"home\";S.tab=\"Posts\";break;\n  case \"clearalerts\":S.alerts=[];break;\n  case \"sendmsg\":var m=p.querySelector(\"#csp-msg\").value.trim();if(!m)return toast(\"type a message\");S.msgs.push(m);break;\n  case \"open\":toast(el.dataset.i+\" — offline stub\");return;\n  default:return}\n  save();render()}\n function build(){p=document.createElement(\"aside\");p.id=\"csp-panel\";p.setAttribute(\"aria-label\",\"CRYPTO SIDE PANEL\");\n  var slot=document.getElementById(\"roster\");(slot||document.body).appendChild(p);\n  p.addEventListener(\"click\",function(ev){var el=ev.target.closest(\"[data-a]\");if(!el||!p.contains(el))return;if(el.tagName===\"A\")return;ev.preventDefault();ev.stopPropagation();act(el.dataset.a,el)});\n  p.addEventListener(\"dblclick\",function(ev){var t=ev.target.closest(\"[data-a]\");if(!t)return;var a=t.dataset.a,tx=t.textContent,k=null,o=S,lab;\n   if(a===\"people\"){k=/Following/.test(tx)?\"following\":\"followers\"}else if(a===\"wallet\"){k=\"rdg\"}else if(S.eng&&({reply:1,repost:1,like:1,views:1})[a]){o=S.eng;k=a}\n   if(!k)return;ev.preventDefault();var v=prompt(\"Set \"+k,o[k]);if(v===null)return;v=+v;if(isNaN(v))return;o[k]=k===\"rdg\"?v.toFixed(2):Math.max(0,Math.round(v));save();render();toast(k+\" = \"+o[k]+\" · saved offline\")});\n  p.addEventListener(\"focusout\",function(ev){var k=ev.target.dataset&&ev.target.dataset.e;if(!k)return;var v=ev.target.innerText.trim();if(k!==\"ptext\"&&k!==\"bio\")v=v.replace(/\\s+/g,\" \");S.prof[k]=v||D.prof[k]||\"\";save();if(k===\"bio\"||k===\"link\")render();toast(k+\" saved · offline\")});\n  p.addEventListener(\"keydown\",function(ev){if(ev.key===\"Enter\"&&ev.target.dataset&&ev.target.dataset.e&&ev.target.dataset.e!==\"ptext\"&&ev.target.dataset.e!==\"bio\"){ev.preventDefault();ev.target.blur();return}if(ev.key===\"Enter\"&&!ev.shiftKey){if(ev.target.id===\"csp-msg\")act(\"sendmsg\");else if(ev.target.closest&&ev.target.closest(\".csp-replybox\"))act(\"sendreply\",ev.target)}});\n  render()}\n setTimeout(retry,1500);window.RDRAGON_CSP={botReply:bot,attachData:function(m){S.draft=(S.draft||[]).concat([m])},toggle:function(v){S.on=v===undefined?!S.on:!!v;save();render()},setRDG:function(n){S.rdg=(+n||0).toFixed(2);save();render()},reset:function(){localStorage.removeItem(LS);S=JSON.parse(JSON.stringify(D));render()}};\n document.addEventListener(\"keydown\",function(e){if((e.metaKey||e.ctrlKey)&&e.shiftKey&&(e.key===\"K\"||e.key===\"k\")){e.preventDefault();window.RDRAGON_CSP.toggle()}});\n if(document.readyState===\"loading\")document.addEventListener(\"DOMContentLoaded\",build);else build();\n})();\n",
  "skills/crypto-side-panel/crypto-side-panel.css": "/* RDRAGON · CRYPTO SIDE PANEL — CryptoSocial profile structure INSIDE RDRAGON left slot (#roster). t50u–t53u. Unsigned pack 20261025. */\nbody:has(#roster #csp-panel:not(.csp-off)){--ds-side:360px}\n#csp-panel{position:relative;width:auto;box-sizing:border-box;background:#000;color:#39ff14;font:12.5px/1.5 \"Menlo\",\"Consolas\",\"Courier New\",monospace;border-top:2px solid #39ff14;margin-top:8px}\n#csp-panel *{box-sizing:border-box}\nbody>#csp-panel{position:fixed;left:0;top:0;bottom:0;width:340px;z-index:900;overflow:auto}\n#csp-panel button,#csp-panel [data-a]{cursor:pointer}\n#csp-panel button{background:#000;color:#39ff14;border:1px solid #39ff14;font:11px monospace;padding:2px 8px}\n#csp-panel button:hover{border-color:#8a2be2;color:#b388ff}\n#csp-panel a{color:#7fb3ff;text-decoration:none}#csp-panel a:hover{text-decoration:underline}\n.csp-top{text-align:center;font-size:12px;padding:6px 26px;position:relative}\n.csp-x{position:absolute;right:4px;top:4px;padding:0 6px!important}\n#csp-panel.csp-off>*:not(.csp-top){display:none}\n.csp-banner{position:relative;height:120px;background:#1a0630 center/cover no-repeat;border-bottom:3px solid #4fb0c6}\n.csp-banner:hover::after,.csp-av:hover::after{content:\"change\";position:absolute;right:4px;top:4px;font-size:10px;background:#000c;color:#39ff14;padding:0 4px;border:1px solid #8a2be2}\n.csp-sv{position:absolute;left:8px;bottom:-11px;background:#111!important;color:#fff!important;border:1px solid #c9a227!important;border-radius:10px;font:700 8px sans-serif!important;padding:3px 8px!important}\n.csp-sv::before{content:\"✔ \";color:#4f8cff}\n.csp-av{display:block;position:relative;width:70px;height:70px;margin:-38px auto 0;border:2px solid #39ff14;background:#000 center/cover no-repeat}\n.csp-name{text-align:center;color:#ddd;font-size:15px;margin-top:8px}\n.csp-handle{text-align:center;margin-bottom:8px}\n.csp-bm{display:grid;grid-template-columns:1fr;gap:6px;padding:0 10px}\n.csp-meta{color:#1f8f0f}.csp-meta div::before{content:\"✓ \"}\n.csp-ff{color:#ddd}.csp-ff b{color:#fff}\n.csp-wallet{margin:8px 10px;border:1px solid #8a2be2;padding:4px 8px;display:flex;justify-content:space-between}\n.csp-wx{margin:0 10px 6px;border:1px dashed #8a2be2;padding:6px 8px}\n.csp-tabs{display:flex;justify-content:space-between;font-size:14px;padding:8px 10px 4px;border-bottom:1px solid #333}\n.csp-tabs span.on{text-decoration:underline;text-underline-offset:5px}\n.csp-view{min-height:120px;padding:6px 4px}\n.csp-card{border:2px solid #8a2be2;padding:5px 7px;margin-bottom:6px}\n.csp-card .l::before{content:\"✓ \"}.csp-card .w{color:#ddd}\n.csp-card .rep{color:#7fb3ff;font-size:11px;padding-left:12px}\n.csp-img{border:2px solid #39ff14;margin-top:4px;height:150px;background:#000 center/cover no-repeat}\n.csp-eng{display:flex;justify-content:space-between;padding:4px 4px 2px;font-size:12px}\n.csp-eng span.on{color:#ff3355}.csp-eng span.rp.on{color:#b388ff}\n.csp-in{width:100%;background:#000;color:#39ff14;border:1px solid #39ff14;font:12px monospace;padding:4px;margin:4px 0}\n.csp-row{display:flex;justify-content:space-between;align-items:center;gap:6px;padding:3px 0;border-bottom:1px dotted #1f3f1f}\n.csp-dim{color:#1f8f0f}\n.csp-nav{display:flex;justify-content:space-around;font-size:18px;padding:8px 0;border-top:1px solid #333}\n.csp-nav span.on{text-shadow:0 0 6px #39ff14}.csp-nav .plus{color:#b388ff;border:2px solid #8a2be2;border-radius:50%;width:30px;height:30px;line-height:26px;text-align:center}\n.csp-ready{padding:2px 10px 12px;font-size:11px;line-height:1.3}.csp-ready b::after{content:\"_\";animation:csp-blink 1s steps(1) infinite}\n@keyframes csp-blink{50%{opacity:0}}\n.csp-toast{position:sticky;bottom:4px;margin:0 10px;background:#000;border:1px solid #8a2be2;color:#b388ff;padding:4px 6px;font-size:11px}\n/* t54u editable fields */\n.csp-ed{outline:none;border-bottom:1px dashed transparent;cursor:text}\n.csp-ed:hover{border-bottom-color:#8a2be2}.csp-ed:focus{border-bottom-color:#39ff14;background:#0a1a0a}\n.csp-ptext{display:block;white-space:pre-wrap;color:#39ff14}\n.csp-links{font-size:11px;margin-top:2px}.csp-links a{margin-right:6px}\n.csp-x{float:right;background:none;border:0;color:#8a2be2;cursor:pointer}.csp-x:hover{color:#ff3b6b}\n/* t57u: no X on top bar; one-line title */\n#csp-panel .csp-top button,#csp-panel .csp-top [data-a=\"toggle\"]{display:none!important}\n#csp-panel .csp-top{white-space:nowrap;overflow:hidden;text-overflow:ellipsis;font-size:12px;letter-spacing:0}\n#csp-panel .csp-top .csp-ed{white-space:nowrap}\n#csp-panel .csp-top{font-size:10.5px;text-overflow:clip;padding-left:4px;padding-right:4px}\n/* t58u: Verified (left) / Wallet (right) buttons, wallet strip removed */\n#csp-panel .csp-btns{display:flex;justify-content:space-between;gap:8px;margin:6px 10px 4px}\n#csp-panel .csp-b{background:#000;color:#39ff14;border:1px solid #8a2be2;font:inherit;font-size:11px;padding:3px 10px;cursor:pointer}\n#csp-panel .csp-b:hover{background:#1a0630;box-shadow:0 0 6px #8a2be2}\n#csp-panel .csp-b b{color:#39ff14;margin-left:4px}\n\n/* t59u: Verified|Wallet replace banner SUPER VERIFIED badge + dollar bill */\n#csp-panel .csp-banner .csp-b{position:absolute;bottom:4px;z-index:2;font-size:10px;padding:2px 7px}\n#csp-panel .csp-banner .csp-bv{left:6px}\n#csp-panel .csp-banner .csp-bw{right:6px;min-width:62px;min-height:22px}\n#csp-panel .csp-banner .csp-b{bottom:0;min-height:26px;min-width:66px}\n#csp-panel .csp-banner .csp-bv{left:2px}#csp-panel .csp-banner .csp-bw{right:2px}\n\n/* t60u: GHOSTMACHINE logo overlay (old banner CRT spot: top-center) */\n#csp-panel .csp-banner .csp-gm{position:absolute;left:50%;top:12px;width:42px;height:auto;transform:translateX(-50%);z-index:1;pointer-events:none;image-rendering:pixelated}\n\n/* t62u: one distinct divider line; Verified|Wallet pair centered ON the line */\n#csp-panel .csp-banner{border-bottom:1px solid #39ff14!important;box-shadow:none}\n#csp-panel .csp-banner .csp-b{bottom:-13px;height:26px;min-height:26px;min-width:66px;z-index:3;box-sizing:border-box;display:flex;align-items:center;justify-content:center}\n#csp-panel .csp-banner .csp-bv{left:auto;right:50%;margin-right:3px}\n#csp-panel .csp-banner .csp-bw{right:auto;left:50%;margin-left:3px}\n\n/* t63u: each button centered in the gap between banner edge and avatar edge (avatar 74px incl border -> half 37px) */\n#csp-panel .csp-banner .csp-bv{right:auto;margin:0;left:calc((50% - 37px) / 2);transform:translateX(-50%)}\n#csp-panel .csp-banner .csp-bw{left:auto;margin:0;right:calc((50% - 37px) / 2);transform:translateX(50%)}\n\n/* t73u auto-reply */\n#csp-panel .csp-bot{border-left:2px solid #c0392b;padding-left:6px;margin:4px 0 2px 10px}\n"
 }
}